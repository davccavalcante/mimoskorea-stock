# =============================================================================
# Mimos Catalog Studio - environment configuration
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local (it is git-ignored).

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------
# live = real Gemini + Tavily/Exa research
# mock = offline fixtures (no API keys needed; for tests and demos)
STUDIO_PROVIDERS=mock

# woocommerce = real store via REST API
# memory      = in-process fake store (unit tests only)
STUDIO_CATALOG=woocommerce

# Where job history (JSON) and processed images are stored.
STUDIO_DATA_DIR=.data

# Optional browser password prompt (HTTP Basic), format "user:password".
# Leave empty only on a trusted machine or private network.
STUDIO_BASIC_AUTH=

# Host names allowed to open the app (comma separated). Add the machine name or
# IP address when other computers on the network use it, e.g.
#   STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,estoque.local,192.168.0.20
# Requests with any other Host header are refused (protects against DNS rebinding).
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Registrations researched at the same time (the others wait in line) and
# new registrations accepted per minute. Both protect the paid API quotas.
STUDIO_MAX_CONCURRENT_JOBS=2
STUDIO_MAX_JOBS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/apikey)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Latest stable Flash model (September 2026). Pro alternative: gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
# Used automatically, in this order, when the main model is overloaded (HTTP 503)
# or its quota is used up (HTTP 429). Only Gemini 3.x models: 2.5 ignores the
# response schema of the Interactions API.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Upper limit per AI call in milliseconds (writing the listing can take minutes)
GEMINI_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Web research (at least one is required in live mode; both is best)
# -----------------------------------------------------------------------------
# https://app.tavily.com
TAVILY_API_KEY=
# https://dashboard.exa.ai
EXA_API_KEY=
RESEARCH_MAX_SOURCES=12

# -----------------------------------------------------------------------------
# WooCommerce / WordPress
# -----------------------------------------------------------------------------
# Store URL (no trailing slash). Local staging: http://localhost:8080
WC_BASE_URL=http://localhost:8080
# WordPress user with the Shop Manager or Administrator role
WP_USERNAME=
# wp-admin > Users > Profile > Application Passwords > "Add new"
# (requires HTTPS in production; pretty permalinks must be enabled)
WP_APPLICATION_PASSWORD=

# Status given to products after sync.
# New products have no price yet, so they always use WC_STATUS_WHEN_INCOMPLETE.
WC_STATUS_WHEN_COMPLETE=publish
WC_STATUS_WHEN_INCOMPLETE=pending

# SEO plugin that receives meta title/description: none | yoast | rankmath
SEO_PLUGIN=none

# -----------------------------------------------------------------------------
# Store rules
# -----------------------------------------------------------------------------
# Removed from product titles automatically
STORE_NAME=Mimos Korea Design
TITLE_MAX_CHARS=75

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------
IMAGE_SIZE=1200
IMAGE_QUALITY=82
IMAGE_MAX_COUNT=5
IMAGE_MAX_BYTES=12582912
# Only for local tests: allow image downloads from private network addresses
ALLOW_PRIVATE_NETWORK_FETCH=false
