{
  "name": "mimos-catalog-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit -p .",
    "check": "biome ci && tsc --noEmit -p .",
    "test": "vitest run",
    "test:staging": "STAGING_WC_URL=${STAGING_WC_URL:-http://localhost:8080} STAGING_WP_USER=${STAGING_WP_USER:-admin} STAGING_WP_APP_PASSWORD=${STAGING_WP_APP_PASSWORD:-$(tr -d '[:space:]' < ../staging/.cache/app-password.txt)} vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google/genai": "^2.24.0",
    "@phosphor-icons/react": "^2.1.10",
    "geist": "^1.7.2",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "description": "AI-assisted product registration for the Mimos Korea WooCommerce store",
  "engines": {
    "node": ">=22.12"
  }
}
